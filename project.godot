; Engine configuration file.
; XSpaceWar-AI — Godot 4.6 project

config_version=5

[application]

config/name="XSpaceWar-AI"
config/version="4.0.0"
config/description="A modern, AI-driven networked space-fighter — a 2026 reimagining of the classic networked Spacewar! / xspacewar. Apache 2.0."
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[input]

; Gameplay + UI actions. Events are declared empty here and populated at
; runtime from WorldView.key_binds via sync_input_actions() (issue #25), so the
; rebind panel / settings.cfg remain the source of truth while input now flows
; through Godot's InputMap (gaining joypad remapping, touch, and Steam Input).
xsw_turn_left={
"deadzone": 0.5,
"events": []
}
xsw_turn_right={
"deadzone": 0.5,
"events": []
}
xsw_thrust={
"deadzone": 0.5,
"events": []
}
xsw_fire={
"deadzone": 0.5,
"events": []
}
xsw_mine={
"deadzone": 0.5,
"events": []
}
xsw_hyper={
"deadzone": 0.5,
"events": []
}
xsw_toggle_map={
"deadzone": 0.5,
"events": []
}
xsw_toggle_feed={
"deadzone": 0.5,
"events": []
}
xsw_toggle_score={
"deadzone": 0.5,
"events": []
}
xsw_zoom_in={
"deadzone": 0.5,
"events": []
}
xsw_zoom_out={
"deadzone": 0.5,
"events": []
}

[internationalization]

locale/translations=PackedStringArray("res://locale/es.po", "res://locale/fr.po", "res://locale/zh_CN.po", "res://locale/ar.po", "res://locale/hi.po")
rendering/root_node_layout_direction=1

[rendering]

renderer/rendering_method="forward_plus"
viewport/hdr_2d=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.01, 0.01, 0.02, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
