; Engine configuration file.
; XSpaceWar-AI — Godot 4.6 project

config_version=5

[application]

config/name="XSpaceWar-AI"
config/version="1.8.6"
config/description="A modern, AI-driven networked space-fighter — a 2026 reimagining of the classic networked Spacewar! / xspacewar. Apache 2.0."
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="forward_plus"
viewport/hdr_2d=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.01, 0.01, 0.02, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
